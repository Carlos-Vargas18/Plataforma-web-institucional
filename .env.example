# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — EDUCONNECT (BACKEND & FRONTEND)
# Copia este archivo a .env y configura tus valores reales. NUNCA subas .env a Git.
# ==============================================================================

# --- BASE DE DATOS POSTGRESQL / SUPABASE (JDBC) ---
# Ejemplo Supabase Pooler/Direct: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/educonnect_db
DB_USERNAME=postgres
DB_PASSWORD=tu_password_seguro_postgresql
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# --- SEGURIDAD JWT (Clave hexadecimal o Base64 de al menos 32 bytes / 256 bits) ---
JWT_SECRET=reemplazar_con_secreto_criptografico_seguro_de_al_menos_64_caracteres_hex
JWT_EXPIRATION=86400000

# --- CORS ORÍGENES AUTORIZADOS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SERVIDOR DE CORREO SMTP (RECUPERACIÓN DE CONTRASEÑA Y NOTIFICACIONES) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo_institucional@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_google

# --- FRONTEND (VITE) ---
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8080
